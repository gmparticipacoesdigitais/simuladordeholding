# Este arquivo serve como um exemplo das variáveis de ambiente necessárias para o projeto.
# Copie este arquivo para um novo arquivo chamado .env e preencha com suas chaves reais para desenvolvimento local.
# NUNCA comite o arquivo .env no seu controle de versão. Adicione-o ao .gitignore.

# ===============================
# Configuração do Stripe
# ===============================

# Chave publicável do Stripe (segura para usar no código do frontend)
# Encontre em: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Chave secreta do Stripe (USAR APENAS NO BACKEND, ex: Cloud Functions)
# Encontre em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Segredo do Webhook do Stripe (USAR APENAS NO BACKEND para verificar a assinatura do evento)
# Você obtém este valor ao criar um endpoint de webhook no Dashboard do Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# ===============================
# IDs de Produtos e Preços do Stripe
# ===============================

# ID de um Produto do Stripe (geralmente começa com 'prod_')
# Encontre em: https://dashboard.stripe.com/products
STRIPE_PRODUCT_ID=prod_...

# ID de um Preço do Stripe (geralmente começa com 'price_')
# Encontre em: https://dashboard.stripe.com/prices
STRIPE_PRICE_ID=price_...
