# Exemplo de arquivo .env para configurações do Firebase e Stripe

# As variáveis de ambiente são carregadas em ordem de prioridade:
# 1. Variáveis com prefixo VITE_ (para projetos Vite)
# 2. Variáveis sem prefixo (para outros ambientes Node.js)
# 3. Variáveis salvas no localStorage (menos comum para credenciais)

# --- Configurações do Firebase ---
# Obtenha suas credenciais em: https://console.firebase.google.com/
# Preencha com as informações do seu projeto Firebase.

# Para projetos Vite, use VITE_ prefixo:
# VITE_FIREBASE_API_KEY="SUA_API_KEY_DO_FIREBASE"
# VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="seu-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="SEU_MESSAGING_SENDER_ID"
# VITE_FIREBASE_APP_ID="SEU_APP_ID"
# VITE_FIREBASE_MEASUREMENT_ID="SEU_MEASUREMENT_ID"

# Para outros ambientes (Node.js, por exemplo), use sem prefixo:
FIREBASE_API_KEY="SUA_API_KEY_DO_FIREBASE"
FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
FIREBASE_PROJECT_ID="seu-project-id"
FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="SEU_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="SEU_APP_ID"
FIREBASE_MEASUREMENT_ID="SEU_MEASUREMENT_ID"

# --- Configurações do Stripe ---
# Preencha com suas chaves e IDs do Stripe.

# Para projetos Vite, use VITE_ prefixo:
# VITE_STRIPE_PUBLISHABLE_KEY="SUA_CHAVE_PUBLICA_DO_STRIPE"
# VITE_STRIPE_PAYMENT_LINK="SEU_LINK_DE_PAGAMENTO_DO_STRIPE"
# VITE_STRIPE_PRODUCT_ID="SEU_ID_DE_PRODUTO_DO_STRIPE"
# VITE_STRIPE_PRICE_ID="SEU_ID_DE_PRECO_DO_STRIPE"

# Para outros ambientes, use sem prefixo:
STRIPE_PUBLISHABLE_KEY="SUA_CHAVE_PUBLICA_DO_STRIPE"
# Valor de teste fallback: pk_test_51QyV4wIPGzIfZaTD9lLXGnJCmjsC8XYCJNqaBTUmPIKtL3SBNB2Yb4A99vHN58C9m9Nl3yv5dJpWRsB3vK2dVdMo00y1DWQysI

STRIPE_PAYMENT_LINK="SEU_LINK_DE_PAGAMENTO_DO_STRIPE"
# Valor de teste fallback: https://buy.stripe.com/test_cNi8wQg3BcFm6DN2TQfw402

STRIPE_PRODUCT_ID="SEU_ID_DE_PRODUTO_DO_STRIPE"
# Valor de teste fallback: prod_TAfijhTULkKnag

STRIPE_PRICE_ID="SEU_ID_DE_PRECO_DO_STRIPE"
